rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -- User-scoped data: only the owning user can read/write --------------
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // -- Feedback: anyone can submit feedback; anyone can read (for public analytics)
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read:   if true;
    }

    // -- Analytics events: anyone can log events; anyone can read (for aggregated telemetry)
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read:   if true;
    }
  }
}
