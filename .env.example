# ==============================================================================
# PathNavigate — Environment Variables Template
# Copy this file to .env.local and populate with your actual credentials:
#   cp .env.example .env.local
# ==============================================================================

# ── 1. Firebase Authentication & Firestore Config ─────────────────────────────
# Obtain from Firebase Console (https://console.firebase.google.com)
# Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ── 2. Groq Cloud API Key (Llama 3 AI Engine) ─────────────────────────────────
# Generates psychometric career pivot recommendations and DAG learning nodes.
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── 3. Razorpay Payment Gateway Configuration ─────────────────────────────────
# Obtain from Razorpay Dashboard (https://dashboard.razorpay.com)
# Settings → API Keys & Webhooks (supports both Test and Live modes)
#
# Client-side Public Key ID (starts with rzp_test_ or rzp_live_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Server-side Secret Key (keep strictly confidential)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (configured in Razorpay Dashboard → Webhooks)
# Used to verify incoming 'payment.captured' and 'order.paid' events
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── 4. Optional: Google Calendar & Meet OAuth API ─────────────────────────────
# Optional: if configuring automated server-to-server Google Calendar API invites
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
